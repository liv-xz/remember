# RememberMe 前端环境变量配置
# 复制此文件为 .env 并填入真实值
# .env 文件不会被提交到 Git

# 高德地图 — 基础服务 Key
# 获取地址: https://console.amap.com/dev/key/app
# 服务平台选择 "Web端(JS API)"
VITE_AMAP_KEY=your_amap_key_here

# 高德地图 — 安全密钥 (securityJsCode)
# 在控制台 Key 管理页面查看，与 Key 配套使用
# 2021年12月后申请的 Key 必须配置此项
VITE_AMAP_SECRET=your_amap_secret_here
